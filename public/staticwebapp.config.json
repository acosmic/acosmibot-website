{
  "platform": {
    "apiRuntime": "node:18"
  },
  "globalHeaders": {
    "Referrer-Policy": "no-referrer",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
  },
  "routes": [
    {
      "route": "/activities/event-horizon",
      "redirect": "/activities/event-horizon/",
      "statusCode": 302
    },
    {
      "route": "/activities/event-horizon/*",
      "headers": {
        "X-Frame-Options": "",
        "Content-Security-Policy": "frame-ancestors https://discord.com https://ptb.discord.com https://canary.discord.com https://discordapp.com https://1186802023799214223.discordsays.com; base-uri 'self'; object-src 'none'",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    { "route": "/premium", "redirect": "/pricing", "statusCode": 301 },
    { "route": "/docs", "redirect": "/docs/introduction", "statusCode": 301 },
    { "route": "/docs/spotify", "redirect": "/docs/music", "statusCode": 301 },
    {
      "route": "/docs/views/*",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/dashboard",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/servers",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/settings",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/card-studio",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/me",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/profile",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/admin*",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/server/*",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/u/*",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/leaderboard*",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/achievements",
      "rewrite": "/app-shell.html",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
